{
  "name": "report-telegram-bot",
  "version": "0.6.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "TZ=UTC eve start",
    "typecheck": "tsc",
    "scan": "node --use-env-proxy --env-file-if-exists=.env agent/lib/cli.ts",
    "demo": "node --use-env-proxy --env-file-if-exists=.env agent/lib/cli.ts --demo",
    "test": "node --test tests/*.test.ts",
    "cloud:once": "node --use-env-proxy --env-file-if-exists=.env agent/lib/cloud-once.ts",
    "sources:check": "node --use-env-proxy --env-file-if-exists=.env agent/lib/source-check.ts"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "cheerio": "1.2.0",
    "eve": "^0.83.2",
    "pdf-parse": "2.4.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
